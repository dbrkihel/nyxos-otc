# --- Local scratch notes (never commit) --------------------------------------
AGENT_NOTES_*.md
NEXT_STEPS.md

# --- Project-specific (open source repo hygiene) ----------------------------
# Per-character persistence written by modules (loot prefs, hotkey state, etc.).
# Keeps player data out of the repo.
characterdata/

# Local per-user config, with your own hosts and credentials.
# Copy config.example.lua -> config.lua and edit that copy.
config.lua

# Explored minimap, written by game_minimap on logout. Player data.
minimap.otmm

# Worktrees / state created by the Claude Code harness — never commit.
.claude/

# --- Secrets: per-release asset key material ---------------------------------
# Generated by tools/gen_asset_key.py. Regenerate per release; NEVER commit.
# The C++ falls back to a committed dev default when this header is absent.
src/framework/core/keymaterial.gen.h

# Crash-dump analysis scratch (WinDbg symbol cache, minidumps).
crashdumps/

# Archived debug symbols ("symbol vault"): one subfolder per released build, each
# holding that build's NyxosClient.pdb + exe so tools/symbolicate_crash.ps1 can
# turn a player's minidump into a source backtrace. Populated by tools/make_release.ps1.
# The PDBs are already caught by *.pdb, but the exe/build-info.txt here must not be
# committed either -> ignore the whole tree.
/symbols/

# --- Game assets -------------------------------------------------------------
# Legacy 8.60 assets: the .rar stays tracked as the canonical source, but the
# unpacked tree (Tibia.spr / Tibia.dat / pics) is regenerated locally and must
# not be committed.
data/things/860/

# Modern 15.25 assets: user-supplied (appearances.dat + sprite sheets).
# Never committed — devs drop their own copy in here.
data/things/1525/

# Sound bank audio extracted from your own Tibia client install by
# tools/soundbank.py. CipSoft content: the index (soundbank.json) is tracked,
# the audio never is.
data/sounds/sound-*.ogg

# --- Build artefacts (Visual Studio vc17 / MSBuild) --------------------------
# OutDir writes the final binary + debug symbols straight into the repo root.
NyxosClient_*.exe
NyxosClient*.exe
*.pdb
*.ilk
*.exp
*.lib

# Intermediate + output dirs produced by the vc17 solution.
vc17/x64/
vc17/Win32/
vc17/.vs/
vc17/Debug/
vc17/Release/
vc17/Debug_lib/
vc17/Release_lib/
vc17/DirectX/
vc17/OpenGL/

# vcpkg manifest-mode install tree.
vcpkg_installed/

# --- Build artefacts (CMake / Ninja, driven by compile-cmake.ps1) ------------
# build/ is the Release tree; build-debug/ and build-static/ come from the
# matching CMakePresets entries, and -BuildDir can name any other build-*.
build/
build-*/
out/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
Makefile

# --- Logs --------------------------------------------------------------------
*.log
console-trace.log
packet*.log
otclient*.log

