*.tmp_proj
*.vspscc
*.vssscc
.builds
*.pidb
*.scc

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# Generic build leftovers
[Dd]ebug/
[Rr]elease/
x64/
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# --- Editor / tooling --------------------------------------------------------
.vs/
.vscode/
.idea/
.lvimrc
.clang_complete
*.swp
*.bak
*~
*.kate-swap
*.autosave
CMakeLists.txt.user*
tags
Thumbs.db
.directory

# --- Vendored Google ANGLE (third_party/angle) -------------------------------
# Keep the prebuilt ANGLE import libs and DLLs tracked despite the generic
# *.lib / x64/ / bin/ rules above. Parent dirs must be re-included before files.
!third_party/angle/lib/
!third_party/angle/lib/x64/
!third_party/angle/lib/x64/*.lib
!third_party/angle/lib/x64/*.def
!third_party/angle/bin/
!third_party/angle/bin/x64/
!third_party/angle/bin/x64/*.dll

# Deployed ANGLE/Vulkan runtime DLLs copied next to the (ignored) exe by the
# build's post-build step. Reproducible from third_party/angle, so don't track.
/libEGL.dll
/libGLESv2.dll
/d3dcompiler_47.dll
/vulkan-1.dll

# Runtime DLLs the CMake build deploys next to the exe in the repo root
# (vcpkg dependencies: zlib1, lua51, OpenAL32, freetype, libprotobuf, ...).
# All reproducible from vcpkg, so none of them belong in the tree. Root level
# only -- the third_party/angle/bin/x64 allowlist above is unaffected, and this
# also subsumes the four ANGLE entries listed just above.
/*.dll

# --- Archives that shouldn't be committed (allowlist 860.rar) ----------------
*.zip
*.7z
*.gz
*.rar
!data/things/860.rar

# Keep this file tracked regardless of patterns above.
!.gitignore
